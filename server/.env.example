# --- Server ---
PORT=5000
NODE_ENV=development
# Front-end origin(s) allowed to call the API, comma separated
CLIENT_ORIGIN=http://localhost:5173

# --- Database ---
# Local:  mongodb://127.0.0.1:27017/cmtmc
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cmtmc
MONGODB_URI=mongodb://127.0.0.1:27017/cmtmc

# --- Admin login (single admin) ---
ADMIN_EMAIL=admin@example.com
# Generate with:  npm run hash-password -- "your-strong-password"
# Wrap the hash in single quotes because it contains $ characters.
ADMIN_PASSWORD_HASH='$2a$12$replace.this.with.your.generated.hash..................'
# Long random string, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Image uploads ---
# Leave empty to store uploads on this server's disk (server/uploads).
# For production, use Cloudinary: copy the CLOUDINARY_URL from your Cloudinary dashboard.
CLOUDINARY_URL=
CLOUDINARY_FOLDER=cmtmc
# Public base URL of this API, used to build links to locally stored uploads
PUBLIC_API_URL=http://localhost:5000

# --- Crossref (DOI import) ---
# Crossref asks API users to identify themselves with a contact email
CROSSREF_MAILTO=admin@example.com
